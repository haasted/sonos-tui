# Rendered ADR pages — regenerate via `make adr-html`
ADRs/html/

# Raw GENA event bodies captured by `cmd/listening -capture`
/captured-data/

# Speaker cache written by `cmd/listening -cache-file` (example default name)
/speaker-cache.json

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/

/worktrees/

# Binaries
/sonos

# Scratch output from the notifycapture harness, whatever -out it was given
*-captures/

# Recordings made by the demo targets
demos/*.gif

# macOS Finder metadata
.DS_Store
